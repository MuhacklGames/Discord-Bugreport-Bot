# REQUIRED
DISCORD_TOKEN=YOUR_BOT_TOKEN

# Forum channel where final bug reports are created (a Forum Channel ID)
FORUM_CHANNEL_ID=000000000000000000

# Text channel under which temporary intake threads will be created
INTAKE_PARENT_CHANNEL_ID=000000000000000000

# OPTIONAL: link back to your panel message or a channel fallback
# If you use a direct panel message URL, users will be guided back there.
PANEL_MESSAGE_URL=https://discord.com/channels/<guild>/<channel>/<message>
PANEL_TARGET_ID=000000000000000000

# OPTIONAL: restrict which reactions are allowed on report posts
EMOJI_WHITELIST=🎮,📹,🔊,🕹️,🔺,🔴,❌,🟠,🟢,🦢,🚨,🔥
